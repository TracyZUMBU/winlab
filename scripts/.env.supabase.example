# Copier vers scripts/.env.supabase.local (gitignored) pour les commandes CLI distantes.
#
# Compte Supabase qui possède le projet Winlab (PAS le compte ouvert par défaut dans le navigateur).
# Générer le PAT sur https://supabase.com/dashboard/account/tokens (connecté au bon compte).
SUPABASE_ACCESS_TOKEN=sbp_...

# Mot de passe Postgres du projet (Dashboard → Settings → Database).
SUPABASE_DB_PASSWORD=

# Référence projet (déjà utilisée par gen:types).
SUPABASE_PROJECT_ID=lfmkzmgxopogmuyusdde
