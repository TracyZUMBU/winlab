EXPO_PUBLIC_SUPABASE_URL=url-to-your-supabase-project
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nom "humain" du service pour le monitoring (visible dans Slack).
EXPO_PUBLIC_SERVICE_NAME=wintix-mobile

# Nom de la Edge Function Supabase qui relaie les events vers Slack.
EXPO_PUBLIC_MONITORING_SLACK_EDGE_FUNCTION_NAME=monitoring-slack

# Côté Supabase uniquement (Edge Function): mettre SLACK_WEBHOOK_URL dans l'environnement
# de Supabase (pas ici en "EXPO_PUBLIC", car c'est un secret).

# Déclencher manuellement les push « résultats loterie » (debug) :
#   cp scripts/.env.lottery-cron.example scripts/.env.lottery-cron.local
#   # renseigner LOTTERY_RESULTS_NOTIFY_CRON_SECRET (secret Edge Functions)
#   npm run lottery:notify-cron